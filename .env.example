# Public site origin (canonical URLs, sitemap)
PUBLIC_SITE_URL=https://chinesebabypredictor.com

# Web3Forms access key for the /contact-us/ form (https://web3forms.com)
# Leave empty in local dev — the /api/contact endpoint then just logs messages.
PUBLIC_CONTACT_FORM_KEY=

# Google Search Console verification token (content of the meta tag)
PUBLIC_GOOGLE_VERIFICATION=
