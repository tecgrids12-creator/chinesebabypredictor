---
/** Blog listing body (shared by /blog/ and /{locale}/blog/). */
import { safeLocalizedPath, type Locale } from '@i18n/utils';

export interface PostCard {
  slug: string;
  title: string;
  description: string;
  category: string;
  publishDate: string;
  author: string;
}

interface Props {
  posts: PostCard[];
  t: { readMore: string; published: string };
  locale: Locale;
  pageNum?: number;
  totalPages?: number;
  title: string;
  subtitle: string;
}

const { posts, t, locale, pageNum = 1, totalPages = 1, title, subtitle } = Astro.props;
const emojis: Record<string, string> = {
  'Charts & Calendars': '📅',
  'Accuracy & Science': '🔬',
  Guides: '🧭',
  'Myths & Fun': '🎭',
  'Calendarios y tablas': '📅',
  'Precisión y ciencia': '🔬',
  'Guías': '🧭',
  'Mitos y diversión': '🎭',
  'Календари и таблицы': '📅',
  'Точность и наука': '🔬',
  'Руководства': '🧭',
  'Мифы и веселье': '🎭',
  'Calendriers et tableaux': '📅',
  'Précision et science': '🔬',
  'Mythes et amusement': '🎭',
  'Kalenders en tabellen': '📅',
  'Nauwkeurigheid en wetenschap': '🔬',
  'Mythen en plezier': '🎭',
  'चार्ट और कैलेंडर': '📅',
  'सटीकता और विज्ञान': '🔬',
  'गाइड': '🧭',
  'मिथक और मनोरंजन': '🎭',
  'Tabelle e calendari': '📅',
  'Precisione e scienza': '🔬',
  'Guide': '🧭',
  'Miti e divertimento': '🎭',
  'Tabelas e calendários': '📅',
  'Precisão e ciência': '🔬',
  'Guias': '🧭',
  'Mitos e diversão': '🎭',
  'Tabele i kalendarze': '📅',
  'Dokładność i nauka': '🔬',
  'Poradniki': '🧭',
  'Mity i zabawa': '🎭',
  'الجداول والتقاويم': '📅',
  'الدقة والعلم': '🔬',
  'أدلة': '🧭',
  'الخرافات والترفيه': '🎭',
  'Tablolar ve Takvimler': '📅',
  'Doğruluk ve Bilim': '🔬',
  'Rehberler': '🧭',
  'Mitler ve Eğlence': '🎭',
  'Tabel dan Kalender': '📅',
  'Akurasi dan Sains': '🔬',
  'Panduan': '🧭',
  'Mitos dan Hiburan': '🎭',
};
const dateTags: Record<string, string> = {
  es: 'es-ES', fr: 'fr-FR', nl: 'nl-NL', ru: 'ru-RU', hi: 'hi-IN',
  it: 'it-IT', pt: 'pt-BR', pl: 'pl-PL', ar: 'ar-EG', tr: 'tr-TR', id: 'id-ID',
};
import GeoLeadLinks from '@theme/components/GeoLeadLinks.astro';
---

<div class="pt-10">
  <section class="section-shell">
    <p class="chip mb-4"><span aria-hidden="true">📖</span>The Baby Gender Blog</p>
    <h1 class="max-w-3xl font-display text-4xl font-extrabold leading-[1.06] text-plum-900 sm:text-5xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-plum-600">{subtitle}</p>
  </section>
  <GeoLeadLinks />

  <section class="section-shell mt-10">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <article class="reveal calculator-card group flex flex-col p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-lift">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-girl-100 px-3 py-1 text-xs font-bold text-girl-700">
              <span aria-hidden="true">{emojis[post.category] ?? '✨'}</span>{post.category}
            </span>
          </div>
          <h2 class="mt-3 font-display text-xl font-bold leading-snug text-plum-900 group-hover:text-girl-600">
            <a href={safeLocalizedPath(`blog/${post.slug}/`, locale)} class="focusable">{post.title}</a>
          </h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-plum-600">{post.description}</p>
          <div class="mt-4 flex items-center justify-between text-xs font-semibold text-plum-500">
            <time datetime={post.publishDate}>{new Date(post.publishDate).toLocaleDateString(dateTags[locale] ?? 'en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
            <a href={safeLocalizedPath(`blog/${post.slug}/`, locale)} class="focusable font-bold text-girl-600 transition group-hover:underline">{t.readMore} →</a>
          </div>
        </article>
      ))}
    </div>

    {totalPages > 1 && (
      <nav aria-label="Blog pages" class="mt-10 flex items-center justify-center gap-2">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
          <a
            href={safeLocalizedPath(p === 1 ? 'blog/' : `blog/${p}/`, locale)}
            aria-current={p === pageNum ? 'page' : undefined}
            class={`focusable grid h-10 w-10 place-items-center rounded-full font-display font-bold transition ${
              p === pageNum ? 'bg-plum-800 text-white' : 'bg-white text-plum-700 ring-1 ring-cream-200 hover:bg-girl-100'
            }`}
          >
            {p}
          </a>
        ))}
      </nav>
    )}
  </section>

</div>
