---
import GenderQuiz from '@components/calculators/GenderQuiz.tsx';
import RelatedTools from '@theme/components/RelatedTools.astro';
import type { Dictionary } from '@i18n/translations';
import type { Locale } from '@i18n/utils';
import { safeLocalizedPath } from '@i18n/utils';

interface Props { t: Dictionary; locale: Locale; }
const { t, locale } = Astro.props;
const q = t.quiz;
const quizQuestions = [q.q1, q.q2, q.q3, q.q4, q.q5, q.q6, q.q7, q.q8, q.q9, q.q10, q.q11, q.q12];
const quizStrings = {
  heading: q.heading, restart: q.restart, yes: q.yes ?? 'Yes ✓', no: q.no ?? 'No ✗',
  resultBoy: q.resultBoy, resultGirl: q.resultGirl,
  share: t.cta.shareLink, disclaimer: t.common.entertainment, progress: q.progress ?? 'Legend verdict',
  blueSignals: q.blueSignals, shareText: q.shareText,
  questions: quizQuestions,
};
const paths = { scoreBody: (q.scoreBody ?? '').replaceAll('{predictorPath}', safeLocalizedPath('chinese-gender-predictor/', locale)) };
import GeoLeadLinks from '@theme/components/GeoLeadLinks.astro';
---

<div class="pt-10">
  <div class="section-shell grid items-start gap-10 lg:grid-cols-2">
    <div>
      <h1 class="font-display text-4xl font-extrabold leading-[1.06] text-plum-900 sm:text-5xl">
        <Fragment set:html={q.h1} />
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-plum-600">{q.intro}</p>
      <div class="mt-6 rounded-3xl bg-boy-50/60 p-5 ring-1 ring-boy-100">
        <p class="font-display font-bold text-plum-800">{q.scoreTitle}</p>
        <p class="mt-1.5 text-sm leading-relaxed text-plum-600"><Fragment set:html={paths.scoreBody} /></p>
      </div>
    </div>
    <div class="lg:sticky lg:top-24"><GenderQuiz client:idle strings={quizStrings} /></div>
  </div>

  <section class="section-shell mt-14">
    <div class="prose-custom">
      <h2>{q.talesTitle}</h2>
      <p><Fragment set:html={q.talesBody.replaceAll('{blogPath}', safeLocalizedPath('blog/', locale))} /></p>
    </div>
  </section>
  <GeoLeadLinks />

  <RelatedTools t={t} locale={locale} exclude="gender-quiz/" />
</div>
