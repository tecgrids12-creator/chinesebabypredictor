---
import MayanPredictor from '@components/calculators/MayanPredictor.tsx';
import RelatedTools from '@theme/components/RelatedTools.astro';
import type { Dictionary } from '@i18n/translations';
import type { Locale } from '@i18n/utils';
import { safeLocalizedPath } from '@i18n/utils';

interface Props { t: Dictionary; locale: Locale; }
const { t, locale } = Astro.props;
const m = { ...t.mayan, vsBody: (t.mayan.vsBody ?? '').replaceAll('{predictorPath}', safeLocalizedPath('chinese-gender-predictor/', locale)) };
import GeoLeadLinks from '@theme/components/GeoLeadLinks.astro';
---

<div class="pt-10">
  <section class="section-shell grid items-start gap-10 lg:grid-cols-2">
    <div>
      <h1 class="font-display text-4xl font-extrabold leading-[1.06] text-plum-900 sm:text-5xl">
        <Fragment set:html={m.h1} />
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-plum-600">{m.intro}</p>
      <div class="mt-6 rounded-3xl bg-cream-100 p-5 ring-1 ring-cream-200">
        <p class="font-display font-bold text-plum-800">{m.ruleTitle}</p>
        <p class="mt-1.5 text-sm font-semibold leading-relaxed text-plum-600">{m.rule}</p>
        <p class="mt-2 text-xs text-plum-500">{m.ruleFoot}</p>
      </div>
    </div>
    <div class="lg:sticky lg:top-24"><MayanPredictor client:idle strings={m} /></div>
  </section>
  <GeoLeadLinks />

  <section class="section-shell mt-14">
    <div class="prose-custom">
      <h2>{m.vsTitle}</h2>
      <p><Fragment set:html={m.vsBody} /></p>
      <h2>{m.originTitle}</h2>
      <p><Fragment set:html={m.originBody} /></p>
    </div>
  </section>

  <RelatedTools t={t} locale={locale} exclude="mayan-gender-predictor/" />
</div>
