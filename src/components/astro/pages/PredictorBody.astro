---
/** Dedicated predictor page body (SEO landing for "chinese gender predictor"). */
import GenderPredictor from '@components/calculators/GenderPredictor.tsx';
import FaqAccordion from '@theme/components/FaqAccordion.astro';
import RelatedTools from '@theme/components/RelatedTools.astro';
import { HOME_FAQ } from '@content/data/editorial';
import type { Dictionary } from '@i18n/translations';
import type { Locale } from '@i18n/utils';
import { safeLocalizedPath } from '@i18n/utils';

interface Props { t: Dictionary; locale: Locale; }
const { t, locale } = Astro.props;
const g = t.geo;
const p = t.predictor;
const predictorStrings = { ...p, copy: t.cta.copy, copied: t.cta.copied, shareLink: t.cta.shareLink };
const predictorPath = safeLocalizedPath('chinese-gender-predictor/', locale);

const howSteps = [
  { emoji: '🎂', title: g.howStep1Title, text: g.howStep1Text },
  { emoji: '🌱', title: g.howStep2Title, text: g.howStep2Text },
  { emoji: '✨', title: g.howStep3Title, text: g.howStep3Text },
];
const faqItems = t.faqHome ?? HOME_FAQ;
import GeoLeadLinks from '@theme/components/GeoLeadLinks.astro';
---

<div class="pt-10">
  <div class="section-shell grid items-start gap-10 lg:grid-cols-[1fr_1.05fr]">
    <div>
      <p class="chip mb-4"><span aria-hidden="true" class="h-2 w-2 rounded-full bg-gradient-to-r from-girl-500 to-boy-500"></span>{t.hero.kicker}</p>
      <h1 class="font-display text-[2.5rem] font-extrabold leading-[1.12] text-plum-900 sm:text-5xl">
        {p.heading} <span class="bg-gradient-to-r from-girl-500 via-girl-400 to-boy-500 bg-clip-text text-transparent">2026</span>
      </h1>
      <span class="mt-4 block h-1.5 w-16 rounded-full" aria-hidden="true" style="background-image: linear-gradient(to right, var(--color-girl-500), var(--color-boy-500)); box-shadow: 0 4px 10px -3px rgba(221,33,117,.45);"></span>
      <p class="mt-4 text-lg leading-relaxed text-plum-600">{t.hero.subtitle}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        <span class="chip"><span aria-hidden="true" class="h-2 w-2 rounded-full" style="background-image:linear-gradient(120deg,#dd2175,#2c63e8)"></span>{t.hero.trust1}</span>
        <span class="chip"><span aria-hidden="true" class="h-2 w-2 rounded-full" style="background-image:linear-gradient(120deg,#2c63e8,#f59e0b)"></span>{t.hero.trust3}</span>
      </div>
      <div class="mt-8 rounded-3xl p-5" style="border: 1px solid transparent; background: linear-gradient(rgba(253,242,248,.65), rgba(253,242,248,.65)) padding-box, linear-gradient(120deg, rgba(238,90,151,.3), rgba(126,169,249,.3)) border-box;">
        <p class="font-display font-bold text-plum-800">🍼 {t.common.entertainment}</p>
        <p class="mt-1.5 text-sm leading-relaxed text-plum-600">{t.common.medicalNote}</p>
      </div>
    </div>
    <div class="lg:sticky lg:top-24 min-h-[480px]"><GenderPredictor client:idle strings={predictorStrings} /></div>
  </div>

  <section class="section-shell mt-16" aria-labelledby="pred-how">
    <h2 id="pred-how" class="section-title">{p.predHowTitle}</h2>
    <p class="mt-3 max-w-3xl leading-relaxed text-plum-600">{p.predHowIntro}</p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {howSteps.map((step, i) => (
        <div class="calculator-card p-6">
          <span class="grid h-8 w-8 place-items-center rounded-full font-display text-sm font-extrabold text-white" style={`background-image: linear-gradient(135deg, ${['#dd2175', '#2c63e8', '#f59e0b'][i]}); box-shadow: 0 8px 18px -6px rgba(221,33,117,.5);`}>{i + 1}</span>
          <p class="mt-3 text-3xl" aria-hidden="true">{step.emoji}</p>
          <h3 class="mt-1.5 font-display text-lg font-bold text-plum-900">{step.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-plum-600">{step.text}</p>
        </div>
      ))}
    </div>
  </section>
  <GeoLeadLinks />

  <section class="section-shell mt-14">
    <div class="prose-custom">
      <h2>{p.decode1Title}</h2>
      <p><Fragment set:html={p.decode1Body} /></p>
      <h2>{p.decode2Title}</h2>
      <p><Fragment set:html={p.decode2Body} /></p>
      <h2>{p.decode3Title}</h2>
      <p><Fragment set:html={p.decode3Body} /></p>
    </div>
  </section>

  <section class="section-shell mt-14" aria-labelledby="pred-faq">
    <h2 id="pred-faq" class="section-title text-center">{p.faqTitle}</h2>
    <div class="mt-6"><FaqAccordion items={faqItems} /></div>
  </section>

  <RelatedTools t={t} locale={locale} exclude="chinese-gender-predictor/" />
</div>
