---
import GenderPlanner from '@components/calculators/GenderPlanner.tsx';
import RelatedTools from '@theme/components/RelatedTools.astro';
import type { Dictionary } from '@i18n/translations';
import type { Locale } from '@i18n/utils';

interface Props { t: Dictionary; locale: Locale; }
const { t, locale } = Astro.props;
const p = t.planner;
import GeoLeadLinks from '@theme/components/GeoLeadLinks.astro';
---

<div class="pt-10">
  <section class="section-shell grid items-start gap-10 lg:grid-cols-2">
    <div>
      <h1 class="font-display text-4xl font-extrabold leading-[1.06] text-plum-900 sm:text-5xl">
        <Fragment set:html={p.h1} />
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-plum-600">{p.intro}</p>
      <div class="mt-6 rounded-3xl bg-girl-50/60 p-5 ring-1 ring-girl-100">
        <p class="font-display font-bold text-plum-800">{p.calloutTitle}</p>
        <p class="mt-1.5 text-sm leading-relaxed text-plum-600">{p.calloutBody}</p>
      </div>
    </div>
    <div class="lg:sticky lg:top-24"><GenderPlanner client:idle strings={p} /></div>
  </section>
  <GeoLeadLinks />

  <section class="section-shell mt-14">
    <div class="prose-custom">
      <h2>{p.readTitle}</h2>
      <p><Fragment set:html={p.readBody} /></p>
      <h2>{p.timingTitle}</h2>
      <p><Fragment set:html={p.timingBody} /></p>
    </div>
  </section>

  <RelatedTools t={t} locale={locale} exclude="gender-planner/" />
</div>
