---
/** Full interactive Chinese gender chart page. */
import InteractiveChart from '@components/calculators/InteractiveChart.tsx';
import FaqAccordion from '@theme/components/FaqAccordion.astro';
import RelatedTools from '@theme/components/RelatedTools.astro';
import { CHART_FAQ } from '@content/data/editorial';
import type { Dictionary } from '@i18n/translations';
import type { Locale } from '@i18n/utils';

interface Props { t: Dictionary; locale: Locale; }
const { t, locale } = Astro.props;
const c = t.chart;

const year = new Date().getUTCFullYear();
const fill = (s: string) => s
  .replaceAll('{year}', String(year))
  .replaceAll('{prev}', String(year - 1))
  .replaceAll('{next}', String(year + 1));

const chartStrings = {
  legendBoy: c.legendBoy, legendGirl: c.legendGirl,
  yourCell: c.yourCell, monthsLabel: c.monthsLabel, agesLabel: c.agesLabel,
  print: c.print, cellHint: c.cellHint, months: t.monthList ?? ['1st 🗓️', '2nd', '3rd', '4th', '5th', '6th', '7th', '8th', '9th', '10th', '11th', '12th'],
  boy: c.legendBoy, girl: c.legendGirl, windowLabel: c.windowLabel ?? 'Dates', lunarYearLabel: c.yearWord ?? 'year', leapNote: c.leapNote ?? 'Leap months are mapped to their base month and marked on results.',
};

const faqItems = t.faqChart ?? CHART_FAQ;
import GeoLeadLinks from '@theme/components/GeoLeadLinks.astro';
---

<div class="pt-10">
  <section class="section-shell">
    <h1 class="max-w-3xl font-display text-4xl font-extrabold leading-[1.06] text-plum-900 sm:text-5xl">
      <Fragment set:html={fill(c.h1 ?? '')} />
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-plum-600">{fill(c.intro ?? '')}</p>
    <div class="mt-8"><InteractiveChart client:idle strings={chartStrings} /></div>
  </section>
  <GeoLeadLinks />

  <section class="section-shell mt-14">
    <div class="prose-custom">
      <h2>{c.readTitle}</h2>
      <p><Fragment set:html={fill(c.readBody ?? '')} /></p>
      <h2>{fill(c.edTitle ?? '')}</h2>
      <p><Fragment set:html={fill(c.edBody ?? '')} /></p>
      <h2>{c.chartLeapTitle}</h2>
      <p><Fragment set:html={c.chartLeapBody} /></p>
    </div>
  </section>

  <section class="section-shell mt-14" aria-labelledby="chart-faq">
    <h2 id="chart-faq" class="section-title text-center">{c.faqTitle}</h2>
    <div class="mt-6"><FaqAccordion items={faqItems} /></div>
  </section>

  <RelatedTools t={t} locale={locale} exclude="chinese-gender-chart/" />
</div>
