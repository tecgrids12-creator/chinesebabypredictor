---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import Breadcrumbs from '@theme/components/Breadcrumbs.astro';
import DueDateBody from '@components/astro/pages/DueDateBody.astro';
import { getDictionary } from '@i18n/translations';
import { alternatePaths } from '@i18n/utils';

const locale = 'en';
const t = getDictionary(locale);
---

<BaseLayout
  title={t.meta.dueTitle}
  description={t.meta.dueDesc}
  enPath="due-date-calculator/"
  locale={locale}
  alternates={alternatePaths('due-date-calculator/')}
>
  <Breadcrumbs crumbs={[{ label: t.nav.dueDate }]} locale={locale} t={t} />
  <DueDateBody t={t} locale={locale} />
</BaseLayout>
