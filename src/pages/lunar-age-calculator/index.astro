---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import LunarAgeBody from '@components/astro/pages/LunarAgeBody.astro';
import { getDictionary } from '@i18n/translations';
import { alternatePaths } from '@i18n/utils';

const locale = 'en';
const t = getDictionary(locale);
---

<BaseLayout
  title={t.meta.lunarAgeTitle}
  description={t.meta.lunarAgeDesc}
  enPath="lunar-age-calculator/"
  locale={locale}
  crumbs={[{ label: t.nav.lunarAge }]},
  alternates={alternatePaths('lunar-age-calculator/')}
>
  <LunarAgeBody t={t} locale={locale} />
</BaseLayout>
