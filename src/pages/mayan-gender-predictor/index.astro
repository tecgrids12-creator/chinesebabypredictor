---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import MayanBody from '@components/astro/pages/MayanBody.astro';
import { getDictionary } from '@i18n/translations';
import { alternatePaths } from '@i18n/utils';

const locale = 'en';
const t = getDictionary(locale);
---

<BaseLayout
  title={t.meta.mayanTitle}
  description={t.meta.mayanDesc}
  enPath="mayan-gender-predictor/"
  locale={locale}
  crumbs={[{ label: t.nav.mayan }]},
  alternates={alternatePaths('mayan-gender-predictor/')}
>
  <MayanBody t={t} locale={locale} />
</BaseLayout>
