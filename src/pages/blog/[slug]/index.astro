---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import GeoLeadLinks from '@theme/components/GeoLeadLinks.astro';
import RelatedTools from '@theme/components/RelatedTools.astro';
import { getDictionary } from '@i18n/translations';
import { alternatePaths } from '@i18n/utils';
import { articleSchema, faqPageSchema } from '@utils/schema';

/* Wave-2 authority spokes get visible FAQ sections + FAQPage JSON-LD
   (singular Q&A set, matches the on-page FAQ wording exactly). */
const POST_FAQ: Record<string, Array<{ q: string; a: string }>> = {
  'why-chinese-gender-calculators-disagree': [
    {
      q: 'Why do Chinese gender calculators give different results for the same date?',
      a: "Because they disagree on the inputs, not the grid. The two biggest forks are the mother's age row (Gregorian approximation versus authentic 虚岁 with the Chinese New Year cutoff) and the month column (Gregorian month mapped directly instead of converted through a real lunisolar table). Leap months, due-date reconstruction, chart variants and time-zone boundaries add four more documented forks.",
    },
    {
      q: 'Which Chinese gender predictor method is most authentic?',
      a: 'The one that converts both the mother\'s date of birth and the conception date through an actual solar-to-lunar table (1900–2100), applies the traditional virtual-age (虚岁) rule with the true CNY cutoff for the conception year, and documents its leap-month treatment. Using the "authentic" engine matters for folklore fidelity — but note it does not make the prediction scientifically accurate; the chart is entertainment.',
    },
    {
      q: 'Can two calculators both be right and still disagree?',
      a: 'Yes. If a conception date sits on a boundary — a new moon, a leap-month day-15 split, or Chinese New Year — the folklore answer genuinely depends on which exact day fertilization occurred, and two sites using different rounding can both be internally consistent. Our cusp checker prints the whole fertile window so you can see the flip date instead of a mystery.',
    },
    {
      q: 'Does disagreeing mean the chart is wrong?',
      a: 'It means the conversions were wrong — and that is worth knowing. But even with perfect conversions, the chart is folklore: prediction accuracy at a coin-flip level. Human sex is decided by which sperm fertilizes the egg (X or Y chromosome), and obstetric bodies such as ACOG treat fetal sex determination as biology, not calendar math.',
    },
  ],
  'chinese-gender-predictor-twins': [
    {
      q: 'Does the Chinese gender chart predict twins or triplets?',
      a: 'No. The chart was designed for singleton folklore: one conception date in, one sex out. It has no row or column for multiplicity, so it cannot register that a pregnancy carries two or three babies at all.',
    },
    {
      q: 'What does the chart say for boy-girl twins?',
      a: 'Two different verdicts appear only when the twins\' conceptions (or the egg releases that led to them) fell on either side of a lunar month boundary — then one date reads in one column and the sibling in the next. Otherwise both twins share one cell and one answer. The split is calendar geometry, not prediction skill.',
    },
    {
      q: 'How do you read the Chinese chart for IVF twins or vanishing twins?',
      a: 'Read one cell per transferred embryo using the thaw-and-transfer date, not the retrieval date, if you want the implantation-perspective reading — or per retrieval date for the fertilization perspective. A vanishing twin is read by the same conception date as the survivor, since both embryo and sac began from one date.',
    },
    {
      q: 'Can the Chinese calendar tell if twins are identical or fraternal?',
      a: 'No. That distinction is set at fertilization (one zygote splitting versus two eggs) and weeks later is only detectable by ultrasound. The lunar table sees one date in and one sex out, and identical twins always share a sex anyway.',
    },
  ],
};

export async function getStaticPaths() {
  // EN posts only (bare ids); translated posts are served from /<locale>/blog/.
  const posts = (await getCollection('blog')).filter((post) => !post.id.includes('/'));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const locale = 'en';
const t = getDictionary(locale);
const { Content } = await render(post);

const related = (await getCollection('blog'))
  .filter((p) => !p.id.includes('/') && p.id !== post.id)
  .sort((a, b) => (a.data.category === post.data.category ? -1 : b.data.category === post.data.category ? 1 : 0))
  .slice(0, 3);

const dateStr = post.data.publishDate.toISOString().slice(0, 10);
---

<BaseLayout
  title={`${post.data.title} | Chinese Baby Predictor Blog`}
  description={post.data.description}
  enPath={`blog/${post.id}/`}
  locale={locale}
  alternates={alternatePaths(`blog/${post.id}/`)}
  crumbs={[{ label: 'Blog', href: 'blog/' }, { label: post.data.title }]},
  type="article"
  publishedTime={new Date(post.data.publishDate).toISOString()}
  schema={[
    articleSchema({
      title: post.data.title,
      description: post.data.description,
      slug: post.id,
      publishDate: dateStr,
      author: post.data.author,
    }),
    ...(POST_FAQ[post.id] ? [faqPageSchema(POST_FAQ[post.id])] : []),
  ]}
>
  <article class="pt-10">
    <header class="section-shell max-w-3xl">
      <span class="rounded-full bg-girl-100 px-3.5 py-1.5 text-xs font-bold text-girl-700">{post.data.category}</span>
      <h1 class="mt-4 font-display text-4xl font-extrabold leading-[1.1] tracking-tight text-plum-900 sm:text-5xl">{post.data.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm font-semibold text-plum-500">
        <time datetime={dateStr}>{new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <span aria-hidden="true">·</span>
        <span>{post.data.author}</span>
      </div>
    </header>
    <GeoLeadLinks />

    <div class="section-shell mt-8">
      <div class="calculator-card p-6 sm:p-10">
        <div class="prose-custom">
          <Content />
        </div>
      </div>
    </div>

    <section class="section-shell mt-12 max-w-4xl" aria-labelledby="more-guides">
      <h2 id="more-guides" class="section-title">Keep exploring</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-3">
        {related.map((rel) => (
          <a href={`/blog/${rel.id}/`} class="reveal calculator-card group p-5 transition hover:-translate-y-1 hover:shadow-lift">
            <p class="text-xs font-bold uppercase tracking-wider text-girl-500">{rel.data.category}</p>
            <p class="mt-1.5 font-display font-bold leading-snug text-plum-900 group-hover:text-girl-600">{rel.data.title}</p>
          </a>
        ))}
      </div>
    </section>

    <RelatedTools t={t} locale={locale} />
  </article>
</BaseLayout>
