---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import ChartBody from '@components/astro/pages/ChartBody.astro';
import { getDictionary } from '@i18n/translations';
import { alternatePaths } from '@i18n/utils';
import { faqPageSchema } from '@utils/schema';
import { CHART_FAQ } from '@content/data/editorial';

const locale = 'en';
const t = getDictionary(locale);
const description = t.meta.chartDesc;
---

<BaseLayout
  title={t.meta.chartTitle}
  description={description}
  enPath="chinese-gender-chart/"
  locale={locale}
  crumbs={[{ label: t.nav.chart }]},
  alternates={alternatePaths('chinese-gender-chart/')}
  schema={[faqPageSchema(CHART_FAQ)]}
>
  <ChartBody t={t} locale={locale} />
</BaseLayout>
