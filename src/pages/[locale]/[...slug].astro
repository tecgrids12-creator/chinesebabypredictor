---
/**
 * Localized pages: /[locale]/ and /[locale]/<tool>/.
 * Default English lives at the root, so locales here exclude 'en'.
 * Content bodies reuse the shared page components; UI strings come from
 * the locale dictionary and missing keys fall back to English.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import HomeBody from '@components/astro/pages/HomeBody.astro';
import PredictorBody from '@components/astro/pages/PredictorBody.astro';
import ChartBody from '@components/astro/pages/ChartBody.astro';
import PlannerBody from '@components/astro/pages/PlannerBody.astro';
import LunarAgeBody from '@components/astro/pages/LunarAgeBody.astro';
import MayanBody from '@components/astro/pages/MayanBody.astro';
import DueDateBody from '@components/astro/pages/DueDateBody.astro';
import QuizBody from '@components/astro/pages/QuizBody.astro';
import BlogListBody, { type PostCard } from '@components/astro/pages/BlogListBody.astro';
import IvfPredictorBody from '@components/astro/pages/IvfPredictorBody.astro';
import PastKidsBacktesterBody from '@components/astro/pages/PastKidsBacktesterBody.astro';
import Calendar2027Body from '@components/astro/pages/Calendar2027Body.astro';
import Calendar2028Body from '@components/astro/pages/Calendar2028Body.astro';
import TtcPlannerBody from '@components/astro/pages/TtcPlannerBody.astro';
import CuspCheckerBody from '@components/astro/pages/CuspCheckerBody.astro';
import { getDictionary } from '@i18n/translations';
import { SUPPORTED_LOCALES, alternatePaths, type Locale } from '@i18n/utils';
import { webAppSchema, faqPageSchema, orgSchema } from '@utils/schema';
import { HOME_FAQ, CHART_FAQ, TTC_FAQ } from '@content/data/editorial';
import { IVF_STRINGS, IVF_FAQ, BACKTEST_STRINGS, BACKTEST_FAQ, CALENDAR_STRINGS, CAL2027_FAQ, CAL2028_FAQ, TTC_STRINGS, CUSP_STRINGS, CUSP_FAQ } from '@i18n/tools';
import { toolStrings } from '@i18n/tools.locales';

export function getStaticPaths() {
  const LOCALE_TOOLS = [
    'chinese-gender-predictor',
    'chinese-gender-chart',
    'gender-planner',
    'lunar-age-calculator',
    'mayan-gender-predictor',
    'due-date-calculator',
    'gender-quiz',
    /* Wave-1 + Wave-2 specialized spokes — full locale parity routes. */
    'cusp-conception-date-checker',
    'chinese-gender-planner-ttc',
    'ivf-chinese-gender-predictor',
    'test-past-pregnancies-calculator',
    'chinese-gender-calendar-2027',
    'chinese-gender-calendar-2028',
    'blog',
  ];
  return SUPPORTED_LOCALES.filter((l) => l !== 'en').flatMap((locale: string) => [
    { params: { locale }, props: { slug: undefined } },
    ...LOCALE_TOOLS.map((slug) => ({ params: { locale, slug }, props: { slug } })),
  ]);
}

const { locale: rawLocale, slug } = Astro.params;
const locale = (rawLocale ?? 'en') as Locale;
const tool = slug;
const t = getDictionary(locale);

// Localized blog listing: posts written in this locale first, EN fallback for
// locales without a translated blog (tier-2 locales).
// Ids of translated posts are '<locale>/<slug>' (files under src/content/blog/<locale>/).
const allPosts = await getCollection('blog');
const localePosts = allPosts
  .filter((post) => (post.id.includes('/') ? post.id.split('/')[0] : 'en') === locale)
  .sort((a, b) => Number(b.data.publishDate) - Number(a.data.publishDate));
const listingPosts = localePosts.length > 0
  ? localePosts
  : allPosts.filter((post) => !post.id.includes('/'))
    .sort((a, b) => Number(b.data.publishDate) - Number(a.data.publishDate));

const blogPosts: PostCard[] = listingPosts
  .slice(0, 12)
  .map((post) => ({
    slug: post.id.split('/').pop()!,
    title: post.data.title,
    description: post.data.description,
    category: post.data.category,
    publishDate: post.data.publishDate.toISOString().slice(0, 10),
    author: post.data.author,
  }));

const enPath = !tool ? '' : `${tool}/`;
const alternates = alternatePaths(enPath);

const pageProps = {
  home: {
    title: t.meta.homeTitle,
    description: t.meta.homeDesc,
    schema: [webAppSchema({ name: 'Chinese Gender Predictor', path: '', description: t.meta.homeDesc }), orgSchema(), faqPageSchema(t.faqHome ?? HOME_FAQ)],
  },
  'chinese-gender-predictor': {
    title: t.meta.predictorTitle,
    description: t.meta.predictorDesc,
    schema: [webAppSchema({ name: 'Chinese Gender Predictor', path: 'chinese-gender-predictor/', description: t.meta.predictorDesc }), faqPageSchema(t.faqHome ?? HOME_FAQ)],
  },
  'chinese-gender-chart': { title: t.meta.chartTitle, description: t.meta.chartDesc, schema: [faqPageSchema(t.faqChart ?? CHART_FAQ)] },
  'gender-planner': { title: t.meta.plannerTitle, description: t.meta.plannerDesc, schema: [] },
  'lunar-age-calculator': { title: t.meta.lunarAgeTitle, description: t.meta.lunarAgeDesc, schema: [] },
  'mayan-gender-predictor': { title: t.meta.mayanTitle, description: t.meta.mayanDesc, schema: [] },
  'due-date-calculator': { title: t.meta.dueTitle, description: t.meta.dueDesc, schema: [] },
  'gender-quiz': { title: t.meta.quizTitle, description: t.meta.quizDesc, schema: [] },
  blog: { title: t.meta.blogTitle, description: t.meta.blogDesc, schema: [] },
};

/* Wave-1/Wave-2 spoke meta + schema, localized via per-locale tool strips. */
const ivfS = toolStrings(IVF_STRINGS, locale, 'ivf');
const backtestS = toolStrings(BACKTEST_STRINGS, locale, 'backtest');
const calS = toolStrings(CALENDAR_STRINGS, locale, 'calendar');
const ttcS = toolStrings(TTC_STRINGS, locale, 'ttc');
const cuspS = toolStrings(CUSP_STRINGS, locale, 'cusp');
const fillYear = (s: string, year: number) => s.replaceAll('{year}', String(year));

pageProps['ivf-chinese-gender-predictor'] = {
  title: ivfS.metaTitle,
  description: ivfS.metaDesc,
  schema: [webAppSchema({ name: 'IVF & FET Chinese Gender Predictor', path: 'ivf-chinese-gender-predictor/', description: ivfS.metaDesc }), faqPageSchema(IVF_FAQ)],
};
pageProps['test-past-pregnancies-calculator'] = {
  title: backtestS.metaTitle,
  description: backtestS.metaDesc,
  schema: [webAppSchema({ name: 'Past Pregnancies Accuracy Tester', path: 'test-past-pregnancies-calculator/', description: backtestS.metaDesc }), faqPageSchema(BACKTEST_FAQ)],
};
pageProps['chinese-gender-calendar-2027'] = {
  title: fillYear(calS.metaTitle, 2027),
  description: fillYear(calS.metaDesc, 2027),
  schema: [webAppSchema({ name: '2027 Chinese Gender Calendar', path: 'chinese-gender-calendar-2027/', description: fillYear(calS.metaDesc, 2027) }), faqPageSchema(CAL2027_FAQ)],
};
pageProps['chinese-gender-calendar-2028'] = {
  title: fillYear(calS.metaTitle, 2028),
  description: fillYear(calS.metaDesc, 2028),
  schema: [webAppSchema({ name: '2028 Chinese Gender Calendar', path: 'chinese-gender-calendar-2028/', description: fillYear(calS.metaDesc, 2028) }), faqPageSchema(CAL2028_FAQ)],
};
pageProps['chinese-gender-planner-ttc'] = {
  title: ttcS.metaTitle,
  description: ttcS.metaDesc,
  schema: [webAppSchema({ name: 'Chinese Gender Planner (TTC)', path: 'chinese-gender-planner-ttc/', description: ttcS.metaDesc }), faqPageSchema(TTC_FAQ)],
};
pageProps['cusp-conception-date-checker'] = {
  title: cuspS.metaTitle,
  description: cuspS.metaDesc,
  schema: [webAppSchema({ name: 'Cusp Conception Date Chinese Baby Predictor', path: 'cusp-conception-date-checker/', description: cuspS.metaDesc }), faqPageSchema(CUSP_FAQ)],
};

const SPOKE_CRUMBS: Record<string, string> = {
  'cusp-conception-date-checker': cuspS.metaTitle,
  'chinese-gender-planner-ttc': t.nav.ttc ?? 'TTC Planner',
  'ivf-chinese-gender-predictor': 'IVF & FET Gender Predictor',
  'test-past-pregnancies-calculator': 'Past Pregnancies Accuracy Tester',
  'chinese-gender-calendar-2027': '2027 Chinese Gender Calendar',
  'chinese-gender-calendar-2028': '2028 Chinese Gender Calendar',
};

const NAV_KEY_BY_SLUG: Record<string, string> = {
  'chinese-gender-predictor': 'predictor',
  'chinese-gender-chart': 'chart',
  'gender-planner': 'planner',
  'lunar-age-calculator': 'lunarAge',
  'mayan-gender-predictor': 'mayan',
  'due-date-calculator': 'dueDate',
  'gender-quiz': 'quiz',
  blog: 'blog',
};

const current = !tool ? pageProps.home : pageProps[tool];
const crumbs = tool
  ? [{ label: SPOKE_CRUMBS[tool] ?? t.nav[NAV_KEY_BY_SLUG[tool] ?? 'blog'] ?? tool }]
  : [];
---

<BaseLayout
  title={current.title}
  description={current.description}
  enPath={enPath}
  locale={locale}
  crumbs={crumbs}
  alternates={alternates}
  schema={current.schema as Record<string, unknown>[]}
>
  {tool === undefined && <HomeBody t={t} locale={locale} />}

  {tool === 'chinese-gender-predictor' && (
    <>
      <PredictorBody t={t} locale={locale} />
    </>
  )}

  {tool === 'chinese-gender-chart' && (
    <>
      <ChartBody t={t} locale={locale} />
    </>
  )}

  {tool === 'gender-planner' && (
    <>
      <PlannerBody t={t} locale={locale} />
    </>
  )}

  {tool === 'lunar-age-calculator' && (
    <>
      <LunarAgeBody t={t} locale={locale} />
    </>
  )}

  {tool === 'mayan-gender-predictor' && (
    <>
      <MayanBody t={t} locale={locale} />
    </>
  )}

  {tool === 'due-date-calculator' && (
    <>
      <DueDateBody t={t} locale={locale} />
    </>
  )}

  {tool === 'gender-quiz' && (
    <>
      <QuizBody t={t} locale={locale} />
    </>
  )}

  {tool === 'blog' && (
    <BlogListBody
      posts={blogPosts}
      t={{ readMore: t.blog.readMore, published: t.blog.published }}
      locale={locale}
      title={t.meta.blogTitle}
      subtitle={t.meta.blogDesc}
    />
  )}

  {tool === 'ivf-chinese-gender-predictor' && <IvfPredictorBody locale={locale} />}
  {tool === 'test-past-pregnancies-calculator' && <PastKidsBacktesterBody locale={locale} />}
  {tool === 'chinese-gender-calendar-2027' && <Calendar2027Body locale={locale} />}
  {tool === 'chinese-gender-calendar-2028' && <Calendar2028Body locale={locale} />}
  {tool === 'cusp-conception-date-checker' && <CuspCheckerBody locale={locale} />}
  {tool === 'chinese-gender-planner-ttc' && <TtcPlannerBody t={t} locale={locale} />}
</BaseLayout>
