---
/**
 * Wave-3 Programmatic Lunar Age Cluster — 28 Static Pages (Ages 18–45).
 * Comprehensive, rich non-thin data derived from the authentic Qing Palace 28x12 matrix:
 * 1. Specific boy/girl ratio and statistical bias
 * 2. Dedicated 12-month grid with 2026 & 2027 Gregorian conception windows
 * 3. Maternal birth-year quick reference lookup table (CNY-aware)
 * 4. High-converting embedded TTC Planner CTA
 * 5. Full JSON-LD Article + FAQPage (3 age-specific Q&As) + BreadcrumbList
 * 6. Clinical demarcation & Swedish study citation
 * 7. Quick jump matrix to all 28 age pages
 */
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import GeoLeadLinks from '@theme/components/GeoLeadLinks.astro';
import FaqAccordion from '@theme/components/FaqAccordion.astro';
import RelatedTools from '@theme/components/RelatedTools.astro';
import { GENDER_CHART, CHART_MIN_AGE, CHART_MAX_AGE, chartGender } from '@utils/genderChart';
import { lunarNewYear, solarToLunar } from '@utils/lunar';
import { lunarMonthWindows } from '@utils/lunarWindows';
import { faqPageSchema } from '@utils/schema';
import { alternatePaths } from '@i18n/utils';
import { getDictionary } from '@i18n/translations';

export function getStaticPaths() {
  return Array.from({ length: CHART_MAX_AGE - CHART_MIN_AGE + 1 }, (_, i) => {
    const age = CHART_MIN_AGE + i;
    return {
      params: { age: String(age) },
    };
  });
}

const { age: ageParam } = Astro.params;
const age = parseInt(ageParam ?? '25', 10);
const locale = 'en';
const t = getDictionary(locale);

// 1. Data derivation from Qing Palace Matrix
const rowIndex = age - CHART_MIN_AGE;
const rowPattern = GENDER_CHART[rowIndex] ?? 'BBBBBBBBBBBB';
const boyMonths: number[] = [];
const girlMonths: number[] = [];

for (let m = 1; m <= 12; m++) {
  const gender = rowPattern.charAt(m - 1) === 'G' ? 'girl' : 'boy';
  if (gender === 'boy') boyMonths.push(m);
  else girlMonths.push(m);
}

const boyCount = boyMonths.length;
const girlCount = girlMonths.length;
const boyPct = ((boyCount / 12) * 100).toFixed(1);
const girlPct = ((girlCount / 12) * 100).toFixed(1);

let biasDescription = '';
if (boyCount > girlCount) {
  biasDescription = `At Lunar Age ${age}, the Qing Palace chart is male-skewed with ${boyCount} Boy months and only ${girlCount} Girl months (${boyPct}% Boy bias in the matrix).`;
} else if (girlCount > boyCount) {
  biasDescription = `At Lunar Age ${age}, the Qing Palace chart predicts a Girl in ${girlCount} out of 12 lunar months (${girlPct}% Girl bias in the matrix), with only ${boyCount} month(s) predicting Boy.`;
} else {
  biasDescription = `At Lunar Age ${age}, the Qing Palace chart presents an evenly balanced 50/50 distribution with exactly 6 Boy months and 6 Girl months.`;
}

// 2. Gregorian windows for 2026 & 2027
const windows2026 = lunarMonthWindows(2026) ?? [];
const windows2027 = lunarMonthWindows(2027) ?? [];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

interface MonthDetail {
  month: number;
  gender: 'boy' | 'girl';
  w2026Str: string;
  w2027Str: string;
}

const monthDetails: MonthDetail[] = [];
for (let m = 1; m <= 12; m++) {
  const gender = rowPattern.charAt(m - 1) === 'G' ? 'girl' : 'boy';
  const w26 = windows2026.find((w) => w.month === m && !w.isLeap);
  const w27 = windows2027.find((w) => w.month === m && !w.isLeap);

  monthDetails.push({
    month: m,
    gender,
    w2026Str: w26 ? `${fmtDate(w26.start)} – ${fmtDate(w26.end)}, 2026` : 'Window varies',
    w2027Str: w27 ? `${fmtDate(w27.start)} – ${fmtDate(w27.end)}, 2027` : 'Window varies',
  });
}

// 3. Maternal birth years that turn Lunar Age [age] in 2026, 2027, and 2028
interface BirthYearCohort {
  targetYear: number;
  targetZodiac: string;
  birthLunarYear: number;
  startDateStr: string;
  endDateStr: string;
}

const getBirthCohort = (targetYear: number, zodiacName: string): BirthYearCohort => {
  const birthLunarYear = targetYear - age + 1;
  const startCny = lunarNewYear(birthLunarYear);
  const nextCny = lunarNewYear(birthLunarYear + 1);

  const startStr = startCny
    ? startCny.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    : `${birthLunarYear}-01-01`;

  const endDate = nextCny ? new Date(nextCny.getTime() - 86400000) : null;
  const endStr = endDate
    ? endDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
    : `${birthLunarYear}-12-31`;

  return {
    targetYear,
    targetZodiac: zodiacName,
    birthLunarYear,
    startDateStr: startStr,
    endDateStr: endStr,
  };
};

const cohorts = [
  getBirthCohort(2026, 'Year of the Horse'),
  getBirthCohort(2027, 'Year of the Goat'),
  getBirthCohort(2028, 'Year of the Monkey'),
];

// 4. Age-Tailored FAQs
const ageFaqs = [
  {
    q: `Is Lunar Age ${age} better for conceiving a boy or a girl on the Chinese chart?`,
    a: `According to the traditional Qing Palace matrix, Lunar Age ${age} has ${boyCount} Boy month(s) (${boyPct}%) and ${girlCount} Girl month(s) (${girlPct}%). ${
      boyCount > girlCount
        ? `This age is predominantly male-skewed in the ancient chart, with Lunar Months ${boyMonths.join(', ')} designated for boys.`
        : girlCount > boyCount
        ? `This age strongly favors girls in folklore, with Lunar Months ${girlMonths.join(', ')} designated for girls.`
        : `This age is exactly balanced at 50/50, providing equal opportunity for both sexes across the calendar year.`
    }`,
  },
  {
    q: `What Gregorian birth dates turn Lunar Age ${age} in 2026 and 2027?`,
    a: `Your Chinese Lunar Age (虚岁) depends on whether you were born before or after Chinese New Year. In 2026, mothers born between ${cohorts[0].startDateStr} and ${cohorts[0].endDateStr} are Lunar Age ${age}. In 2027, mothers born between ${cohorts[1].startDateStr} and ${cohorts[1].endDateStr} turn Lunar Age ${age}.`,
  },
  {
    q: `What are the best conception dates in 2026–2027 for a ${boyCount >= girlCount ? 'Boy' : 'Girl'} at Lunar Age ${age}?`,
    a: `To target a ${boyCount >= girlCount ? 'Boy' : 'Girl'} at Lunar Age ${age}, the chart recommends conception during Lunar Months ${(boyCount >= girlCount ? boyMonths : girlMonths).slice(0, 4).join(', ')}. For 2026, optimal windows include ${monthDetails.filter(m => m.gender === (boyCount >= girlCount ? 'boy' : 'girl')).slice(0, 2).map(m => `Lunar Month ${m.month} (${m.w2026Str})`).join(' and ')}.`,
  },
];

// 5. Page Metadata & JSON-LD
const title = `Chinese Baby Predictor for Lunar Age ${age}: Gender Chart & Best Months`;
const description = `Discover the Chinese gender predictor results for Lunar Age ${age}. See the 12-month boy/girl breakdown, 2026-2027 conception dates, and birth-year conversion.`;
const canonicalPath = `lunar-age-${age}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    mainEntityOfPage: `https://chinesebabypredictor.com/${canonicalPath}`,
    datePublished: '2026-01-01',
    dateModified: '2026-02-17',
    author: {
      '@type': 'Organization',
      name: 'Chinese Baby Predictor Research Team',
      url: 'https://chinesebabypredictor.com/about-us/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Chinese Baby Predictor',
      logo: {
        '@type': 'ImageObject',
        url: 'https://chinesebabypredictor.com/favicon.svg',
      },
    },
    inLanguage: 'en',
  },
  faqPageSchema(ageFaqs),
];

const prevAge = age > CHART_MIN_AGE ? age - 1 : null;
const nextAge = age < CHART_MAX_AGE ? age + 1 : null;
---

<BaseLayout
  title={title}
  description={description}
  enPath={canonicalPath}
  locale={locale}
  crumbs={[
    { label: 'Lunar Age Calculator', href: 'lunar-age-calculator/' },
    { label: `Lunar Age ${age}` },
  ]}
  alternates={alternatePaths(canonicalPath)}
  schema={schema}
>
  <div class="pt-10">
    {/* Hero Section */}
    <div class="section-shell">
      <div class="max-w-3xl">
        <p class="chip mb-4">
          <span aria-hidden="true" class="h-2 w-2 rounded-full bg-gradient-to-r from-girl-500 to-boy-500"></span>
          Imperial Qing Palace Matrix · Specific Lunar Age Guide
        </p>
        <h1 class="font-display text-[2.35rem] font-extrabold leading-[1.1] text-plum-900 sm:text-5xl">
          Chinese Baby Predictor for <span class="bg-gradient-to-r from-girl-500 via-girl-400 to-boy-500 bg-clip-text text-transparent">Lunar Age {age}</span>
        </h1>
        <span class="mt-4 block h-1.5 w-16 rounded-full" aria-hidden="true" style="background-image: linear-gradient(to right, var(--color-girl-500), var(--color-boy-500)); box-shadow: 0 4px 10px -3px rgba(221,33,117,.45);"></span>
        <p class="mt-4 text-lg leading-relaxed text-plum-600">
          Everything you need to know about <strong>Lunar Age {age}</strong> (虚岁) on the traditional Chinese gender calendar.
          Review the complete 12-month Boy/Girl breakdown, exact 2026–2027 Gregorian conception windows, and birth-year conversion charts.
        </p>

        {/* SEO / GEO link equity funnel within first 100 words */}
        <GeoLeadLinks />

        {/* Statistical Summary Badge */}
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <div class="rounded-2xl bg-boy-50 px-4 py-2.5 text-center ring-1 ring-boy-200">
            <span class="block text-xs font-bold text-boy-600">Boy Months</span>
            <span class="font-display text-2xl font-black text-boy-700">{boyCount} / 12 ({boyPct}%)</span>
          </div>
          <div class="rounded-2xl bg-girl-50 px-4 py-2.5 text-center ring-1 ring-girl-200">
            <span class="block text-xs font-bold text-girl-600">Girl Months</span>
            <span class="font-display text-2xl font-black text-girl-700">{girlCount} / 12 ({girlPct}%)</span>
          </div>
          <div class="flex-1 min-w-[200px] rounded-2xl bg-cream-100 p-3 ring-1 ring-cream-200">
            <span class="text-xs font-semibold text-plum-700">{biasDescription}</span>
          </div>
        </div>
      </div>
    </div>

    {/* Section 1: 12-Month Calendar Grid */}
    <section class="section-shell mt-12" aria-labelledby="months-grid-title">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-cream-200 pb-4">
        <div>
          <h2 id="months-grid-title" class="font-display text-2xl font-extrabold text-plum-900 sm:text-3xl">
            12-Month Gender Grid for Lunar Age {age}
          </h2>
          <p class="mt-1 text-sm text-plum-600">
            Exact Qing Palace chart row mapped to 2026 &amp; 2027 Gregorian conception windows.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1 rounded-full bg-boy-100 px-3 py-1 text-xs font-bold text-boy-800">
            👦 Boy = {boyCount} Months
          </span>
          <span class="inline-flex items-center gap-1 rounded-full bg-girl-100 px-3 py-1 text-xs font-bold text-girl-800">
            👧 Girl = {girlCount} Months
          </span>
        </div>
      </div>

      <div class="mt-6 grid gap-3.5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {monthDetails.map((item) => (
          <div class={`rounded-2xl border-2 p-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-lift ${
            item.gender === 'boy'
              ? 'border-boy-200/90 bg-gradient-to-b from-boy-50/50 via-white to-boy-50/20'
              : 'border-girl-200/90 bg-gradient-to-b from-girl-50/50 via-white to-girl-50/20'
          }`}>
            <div class="flex items-center justify-between">
              <span class="font-display text-xs font-bold uppercase tracking-wider text-plum-500">
                Lunar Month {item.month}
              </span>
              <span class={`rounded-full px-2.5 py-0.5 text-xs font-black ${
                item.gender === 'boy' ? 'bg-boy-500 text-white' : 'bg-girl-500 text-white'
              }`}>
                {item.gender === 'boy' ? '👦 BOY' : '👧 GIRL'}
              </span>
            </div>

            <div class="mt-3 space-y-1.5 text-xs">
              <div class="rounded-xl bg-cream-50 p-2 text-plum-700">
                <span class="block font-bold text-plum-900 text-[11px] uppercase">2026 Gregorian Window:</span>
                <span class="font-semibold">{item.w2026Str}</span>
              </div>
              <div class="rounded-xl bg-cream-50 p-2 text-plum-700">
                <span class="block font-bold text-plum-900 text-[11px] uppercase">2027 Gregorian Window:</span>
                <span class="font-semibold">{item.w2027Str}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Section 2: Maternal Birth-Year Quick Reference Table */}
    <section class="section-shell mt-14" aria-labelledby="birth-years-title">
      <div class="max-w-4xl">
        <h2 id="birth-years-title" class="font-display text-2xl font-extrabold text-plum-900 sm:text-3xl">
          Are You Lunar Age {age}? Maternal Birth-Year Reference
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-plum-600">
          In Chinese traditional <em>Xūsuì</em> counting, a person is age 1 at birth and advances one year on Chinese New Year
          (not on their Gregorian birthday). If you were born before Chinese New Year in your birth year, your lunar birth
          year belongs to the prior Gregorian calendar year.
        </p>

        <div class="mt-6 overflow-x-auto rounded-3xl bg-white shadow-soft ring-1 ring-cream-200">
          <table class="w-full min-w-[640px] border-collapse text-left text-sm">
            <caption class="sr-only">Maternal birth year ranges for Lunar Age {age} across 2026, 2027, and 2028</caption>
            <thead>
              <tr class="bg-plum-800 text-white">
                <th scope="col" class="px-4 py-3.5 font-display text-xs font-bold sm:text-sm">Pregnancy Year</th>
                <th scope="col" class="px-4 py-3.5 font-display text-xs font-bold sm:text-sm">Chinese Zodiac Year</th>
                <th scope="col" class="px-4 py-3.5 font-display text-xs font-bold sm:text-sm">Maternal Birth Lunar Year</th>
                <th scope="col" class="px-4 py-3.5 font-display text-xs font-bold sm:text-sm">Exact Gregorian Birth Date Range</th>
              </tr>
            </thead>
            <tbody class="text-plum-700">
              {cohorts.map((c, idx) => (
                <tr class={`border-t border-cream-200 ${idx % 2 === 0 ? 'bg-cream-50/50' : 'bg-white'}`}>
                  <th scope="row" class="px-4 py-3.5 font-display font-extrabold text-plum-900">
                    In {c.targetYear}
                  </th>
                  <td class="px-4 py-3.5 font-semibold text-plum-800">
                    {c.targetZodiac}
                  </td>
                  <td class="px-4 py-3.5 font-bold text-plum-900">
                    Lunar Year {c.birthLunarYear}
                  </td>
                  <td class="px-4 py-3.5 font-semibold text-girl-700">
                    {c.startDateStr} – {c.endDateStr}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* Section 3: High-Converting Embedded CTA */}
    <section class="section-shell mt-14">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-plum-900 via-plum-800 to-girl-900 p-8 text-center text-white shadow-lift sm:p-12">
        <div class="mx-auto max-w-2xl">
          <span class="inline-block rounded-full bg-white/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-girl-200 backdrop-blur-md">
            Interactive Pregnancy Planning Engine
          </span>
          <h2 class="mt-3 font-display text-2xl font-black text-white sm:text-4xl">
            Planning to Conceive at Lunar Age {age}?
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-white/85 sm:text-base">
            Forecast your personalized optimal conception dates for 2026, 2027, and 2028 with our interactive TTC Planner.
            Filter by desired gender, see upcoming fertile windows, and save your fertility calendar.
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-4">
            <a
              href="/chinese-gender-planner-ttc/"
              class="btn-primary inline-flex items-center gap-2 px-6 py-3.5 text-base font-extrabold shadow-lg transition-transform hover:scale-105"
            >
              🗓️ Plan Your Conception Months for Age {age} in our TTC Planner →
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* Section 4: Clinical Genetics & Swedish Registry Study Notice */}
    <section class="section-shell mt-14">
      <div class="rounded-3xl p-6 ring-1 ring-cream-200 bg-white/80 shadow-soft">
        <h3 class="font-display text-lg font-bold text-plum-900">
          🔬 Clinical Demarcation &amp; Scientific Accuracy Notice
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-plum-600">
          While analyzing the ancient Qing Dynasty matrix for Lunar Age {age} is a delightful cultural tradition,
          scientific obstetrics proves that baby sex is determined solely at fertilization by whether an X- or Y-chromosome
          sperm penetrates the ovum. A landmark 2010 Swedish epidemiological study led by Eduardo Villamor analyzed
          <strong>2,840,440 births</strong> from 1973 to 2006 and found that Chinese calendar predictions matched the real sex
          at approximately <strong>50% (chance levels)</strong> across every maternal age.
          For medically reliable fetal sex determination, consult your healthcare provider regarding
          <a href="https://medlineplus.gov/genetics/understanding/testing/nipt/" rel="nofollow noopener noreferrer" target="_blank" class="font-semibold underline decoration-girl-400 hover:text-plum-900">MedlinePlus non-invasive prenatal testing (NIPT)</a>
          or mid-pregnancy ultrasound scans certified by <a href="https://www.acog.org/womens-health/faqs/routine-tests-during-pregnancy" rel="nofollow noopener noreferrer" target="_blank" class="font-semibold underline decoration-boy-400 hover:text-plum-900">ACOG clinical guidelines</a>.
        </p>
      </div>
    </section>

    {/* Section 5: Age-Tailored FAQ */}
    <section class="section-shell mt-14" aria-labelledby="age-faq-title">
      <h2 id="age-faq-title" class="section-title text-center">
        Frequently Asked Questions: Chinese Gender Predictor for Age {age}
      </h2>
      <div class="mt-6"><FaqAccordion items={ageFaqs} /></div>
    </section>

    {/* Section 6: Previous / Next Age Navigation & Complete Age Cluster Grid */}
    <section class="section-shell mt-14 border-t border-cream-200 pt-10" aria-labelledby="age-nav-title">
      <div class="flex items-center justify-between">
        {prevAge ? (
          <a
            href={`/lunar-age-${prevAge}/`}
            class="group inline-flex items-center gap-2 rounded-2xl bg-white px-4 py-2.5 text-sm font-bold text-plum-800 shadow-soft ring-1 ring-cream-200 transition-colors hover:text-girl-600"
          >
            ← Lunar Age {prevAge} Chart
          </a>
        ) : <div></div>}

        <span class="font-display text-sm font-extrabold text-plum-600">
          Current: Lunar Age {age}
        </span>

        {nextAge ? (
          <a
            href={`/lunar-age-${nextAge}/`}
            class="group inline-flex items-center gap-2 rounded-2xl bg-white px-4 py-2.5 text-sm font-bold text-plum-800 shadow-soft ring-1 ring-cream-200 transition-colors hover:text-girl-600"
          >
            Lunar Age {nextAge} Chart →
          </a>
        ) : <div></div>}
      </div>

      <div class="mt-8 rounded-3xl bg-cream-50 p-6">
        <h3 id="age-nav-title" class="font-display text-center text-sm font-bold uppercase tracking-wider text-plum-500">
          Browse All 28 Lunar Ages (18–45) in the Qing Dynasty Chart
        </h3>
        <div class="mt-4 flex flex-wrap justify-center gap-2">
          {Array.from({ length: 28 }, (_, i) => {
            const a = 18 + i;
            const isCurrent = a === age;
            return (
              <a
                href={`/lunar-age-${a}/`}
                class={`rounded-xl px-3 py-1.5 text-xs font-bold transition-all ${
                  isCurrent
                    ? 'bg-plum-900 text-white shadow-soft scale-105'
                    : 'bg-white text-plum-700 hover:bg-girl-50 hover:text-girl-600 ring-1 ring-cream-200'
                }`}
              >
                Age {a}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <RelatedTools t={t} locale={locale} exclude="lunar-age-calculator/" />
  </div>
</BaseLayout>
