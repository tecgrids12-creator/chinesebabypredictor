---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import PlannerBody from '@components/astro/pages/PlannerBody.astro';
import { getDictionary } from '@i18n/translations';
import { alternatePaths } from '@i18n/utils';

const locale = 'en';
const t = getDictionary(locale);
---

<BaseLayout
  title={t.meta.plannerTitle}
  description={t.meta.plannerDesc}
  enPath="gender-planner/"
  locale={locale}
  crumbs={[{ label: t.nav.planner }]},
  alternates={alternatePaths('gender-planner/')}
>
  <PlannerBody t={t} locale={locale} />
</BaseLayout>
