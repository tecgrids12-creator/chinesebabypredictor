---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import AboutBody from '@components/astro/pages/AboutBody.astro';
import { getDictionary } from '@i18n/translations';
import { orgSchema } from '@utils/schema';

const locale = 'en';
const t = getDictionary(locale);
---

<BaseLayout
  title={`${t.meta.aboutTitle} — Our Story & Data Policy`}
  description="Who we are: the data-accurate, design-obsessed, honesty-first Chinese gender predictor. Our lunar engine, editorial policy and contact channels explained."
  enPath="about-us/"
  locale={locale}
  crumbs={[{ label: 'About us' }]},
  schema={orgSchema()}
>
  <AboutBody t={t} locale={locale} />
</BaseLayout>
