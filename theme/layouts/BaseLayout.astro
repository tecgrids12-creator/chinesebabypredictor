---
/** Base layout shared by every page (theme layout per master prompt). */
import '@styles/global.css';
import '@fontsource-variable/baloo-2';
import '@fontsource-variable/nunito';
import Seo from '@theme/components/Seo.astro';
import Header from '@theme/components/Header.astro';
import Footer from '@theme/components/Footer.astro';
import { getDir, getLangTag, DEFAULT_LOCALE, type Locale } from '@i18n/utils';
import { getDictionary, type Dictionary } from '@i18n/translations';

export interface Props {
  title: string;
  description: string;
  enPath?: string;
  alternates?: Array<{ hreflang: string; href: string }>;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const props = Astro.props;
const locale = (props.locale as Locale | undefined) ?? (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const dir = getDir(locale);
const lang = getLangTag(locale);
const t: Dictionary = getDictionary(locale);
---

<!doctype html>
<html lang={lang} dir={dir} class="scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={props.title}
      description={props.description}
      enPath={props.enPath}
      alternates={props.alternates}
      type={props.type}
      image={props.image}
      publishedTime={props.publishedTime}
      schema={props.schema}
    />
  </head>
  <body class="relative min-h-screen overflow-x-clip">
    {/* decorative floating background blobs */}
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="anim-blob absolute -top-24 -left-24 h-96 w-96 rounded-full bg-girl-100 opacity-70 blur-3xl"></div>
      <div class="anim-blob absolute top-1/3 -right-32 h-[26rem] w-[26rem] rounded-full bg-boy-100 opacity-60 blur-3xl [animation-delay:-6s]"></div>
      <div class="anim-blob absolute bottom-0 left-1/4 h-80 w-80 rounded-full bg-gold-400/10 opacity-50 blur-3xl [animation-delay:-12s]"></div>
    </div>

    <a href="#main" class="skip-link">{t.common.skipToContent}</a>
    <Header t={t} locale={locale} />

    <main id="main" class="relative">
      <slot />
    </main>

    <Footer t={t} locale={locale} />

    {/* scroll reveal progressive enhancement */}
    <script>
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>

