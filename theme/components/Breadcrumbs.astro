---
/** Breadcrumb trail + BreadcrumbList JSON-LD. */
import type { Locale } from '@i18n/utils';
import { localizedPath } from '@i18n/utils';
import type { Dictionary } from '@i18n/translations';

export interface Crumb { label: string; href?: string; }
interface Props { crumbs: Crumb[]; locale: Locale; t: Dictionary; }
const { crumbs, locale, t } = Astro.props;
const site = Astro.site?.origin ?? 'https://chinesebabypredictor.com';

/* GSC fix — Google requires a fully-qualified absolute "item" URL on EVERY
 * ListItem, including position 1 (root) and the final leaf. The root crumb is
 * always the exact brand anchor: EN → https://chinesebabypredictor.com/,
 * localized routes → https://chinesebabypredictor.com/<loc>/. The leaf item is
 * the current page's own canonical URL (no hidden href needed). */
const rootItem = new URL(localizedPath('', locale), site).href;
const leafHrefFull = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const leafItem = new URL(leafHrefFull, site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Chinese Baby Predictor', item: rootItem },
    ...crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: c.label,
      item: new URL(c.href ? localizedPath(c.href, locale) : leafHrefFull, site).href,
    })),
  ],
};
---

<nav aria-label="Breadcrumb" class="section-shell mb-6 flex flex-wrap items-center gap-1.5 text-sm text-plum-500">
  {/* Critical rule: the root crumb is always the exact primary entity anchor. */}
  <a href={localizedPath('', locale)} class="focusable font-semibold transition-colors hover:text-girl-500" title="Chinese Baby Predictor — free lunar gender chart & calculator">Chinese Baby Predictor</a>
  {crumbs.map((c) => (
    <>
      <span aria-hidden="true">›</span>
      {c.href
        ? <a href={localizedPath(c.href, locale)} class="focusable font-semibold transition-colors hover:text-girl-500">{c.label}</a>
        : <span class="font-semibold text-plum-700">{c.label}</span>}
    </>
  ))}
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
