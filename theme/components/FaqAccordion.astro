---
/** Accessible FAQ accordion — native <details>/<summary>, zero JS. */
export interface FaqItem { q: string; a: string; }
interface Props { items: FaqItem[]; }
const { items } = Astro.props;
---

<div class="grid gap-3 md:grid-cols-2">
  {items.map((item, index) => (
    <details class="faq" open={index === 0}>
      <summary>
        {/* H3 inside summary: gives the FAQ a clean h2 > h3 heading hierarchy
            that answer engines lift (question heading + answer directly below). */}
        <h3 class="faq-question">{item.q}</h3>
        <span class="faq-icon" aria-hidden="true">+</span>
      </summary>
      <p class="faq-answer">{item.a}</p>
    </details>
  ))}
</div>
