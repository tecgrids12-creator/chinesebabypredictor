---
/**
 * Pre-footer E-E-A-T / medical disclaimer card (YMYL trust signal).
 * Editorial attribution + folklore disclaimer + authoritative clinical
 * references. All outbound links are nofollow (link equity stays internal).
 * Strings come from the `trust` dictionary (wave-1 layer): localized for the
 * 11 blog-full locales, English fallback elsewhere. Link URL targets stay
 * canonical EN for every locale.
 */
import { SUPPORTED_LOCALES } from '@i18n/utils';
import { getDictionary } from '@i18n/translations';

const seg = Astro.url.pathname.split('/')[1];
const locale = (SUPPORTED_LOCALES as readonly string[]).includes(seg) ? (seg as never) : 'en';
const t = getDictionary(locale).trust;

const linkClass = 'font-semibold underline decoration-plum-700 decoration-2 underline-offset-2 hover:text-plum-900';
const studyLink = `<a href="https://pubmed.ncbi.nlm.nih.gov/20618730/" rel="nofollow noopener noreferrer" target="_blank" class="${linkClass}">${t.studyLinkText}</a>`;
const acogLink = `<a href="https://www.acog.org/womens-health/faqs/prenatal-genetic-screening-tests" rel="nofollow noopener noreferrer" target="_blank" class="font-semibold underline decoration-girl-400 decoration-2 underline-offset-2 hover:text-plum-900">${t.acogLinkText}</a>`;
const medlineLink = `<a href="https://medlineplus.gov/prenataltesting.html" rel="nofollow noopener noreferrer" target="_blank" class="font-semibold underline decoration-girl-400 decoration-2 underline-offset-2 hover:text-plum-900">${t.medlineLinkText}</a>`;

const bodyHtml = t.body.replace('{studyLink}', studyLink);
const disclaimerHtml = `<strong class="font-display text-plum-900">${t.disclaimerTitle}</strong> `
  + t.disclaimerBody.replace('{acogLink}', acogLink).replace('{medlineLink}', medlineLink);
---
<aside
  class="section-shell mt-16"
  aria-labelledby="trust-title"
>
  <div
    class="relative overflow-hidden rounded-3xl border border-plum-700/15 bg-white/70 p-6 shadow-[0_20px_45px_-25px_rgba(69,2,79,.35)] ring-1 ring-white/60 backdrop-blur sm:p-9"
  >
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -top-16 -right-10 h-48 w-48 rounded-full bg-girl-200/40 blur-3xl"></div>
      <div class="absolute -bottom-20 -left-14 h-48 w-48 rounded-full bg-boy-100/50 blur-3xl"></div>
    </div>

    <div class="relative">
      <div class="flex flex-wrap items-center gap-3">
        <span
          class="inline-flex items-center gap-2 rounded-full bg-plum-800 px-3.5 py-1.5 text-xs font-bold tracking-wide text-white shadow-[0_8px_18px_-6px_rgba(69,2,79,.5)]"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2l2.4 5.1 5.6.7-4.1 3.9 1 5.5-4.9-2.7-4.9 2.7 1-5.5L4 7.8l5.6-.7z"></path>
          </svg>
          <span set:html={t.badge} />
        </span>
        <p id="trust-title" class="font-display text-lg font-bold text-plum-900" set:html={t.byline} />
      </div>

      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-plum-700" set:html={bodyHtml} />

      <div class="mt-4 rounded-2xl bg-white/80 p-5 ring-1 ring-plum-700/10">
        <p class="text-sm leading-relaxed text-plum-700" set:html={disclaimerHtml} />
      </div>
    </div>
  </div>
</aside>
