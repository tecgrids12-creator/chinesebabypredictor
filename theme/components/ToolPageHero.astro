---
/** Shared hero block for every tool page. */
interface Props {
  kicker?: string;
  title: string;
  titleAccent?: string;
  subtitle: string;
  trust?: string[];
  emoji: string;
}
const { kicker, title, titleAccent, subtitle, trust, emoji } = Astro.props;
---

<section class="section-shell pt-10 sm:pt-14">
  {kicker && (
    <p class="mb-3 inline-flex chip">
      <span aria-hidden="true">✨</span>{kicker}
    </p>
  )}
  <h1 class="max-w-3xl font-display text-4xl font-extrabold leading-[1.08] tracking-tight text-plum-900 sm:text-5xl">
    {title}{titleAccent && <span class="bg-gradient-to-r from-girl-500 to-boy-500 bg-clip-text text-transparent"> {titleAccent}</span>}
  </h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-plum-600">{subtitle}</p>
  {trust && (
    <div class="mt-5 flex flex-wrap gap-2">
      {trust.map((item, i) => <span class="chip"><span aria-hidden="true">{['🎊', '🔒', '⚡'][i] ?? '✓'}</span>{item}</span>)}
    </div>
  )}
</section>
